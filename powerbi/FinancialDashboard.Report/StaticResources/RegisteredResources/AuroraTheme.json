{
  "name": "AuroraTheme",
  "dataColors": [
    "#1F3A5F",
    "#2A9D8F",
    "#E9C46A",
    "#E76F51",
    "#8AB17D",
    "#6B7785",
    "#264653",
    "#F4A261"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3A5F",
  "good": "#2A9D8F",
  "bad": "#E76F51",
  "neutral": "#E9C46A",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F3A5F"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#374151"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#1F3A5F"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F3A5F"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F3A5F"
              }
            },
            "fontSize": 22
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#6B7785"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}