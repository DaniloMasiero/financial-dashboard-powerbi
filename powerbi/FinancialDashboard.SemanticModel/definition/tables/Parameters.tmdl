table Parameters
	isHidden
	lineageTag: 225fddd4-837f-5cf9-b7ac-8f731ba51cfb

	column SnapshotDate
		dataType: dateTime
		formatString: mmm d, yyyy
		lineageTag: bca460c3-8c96-521c-80c4-34ff87bb6312
		summarizeBy: none
		sourceColumn: SnapshotDate

		annotation UnderlyingDateTimeDataType = Date

	column OpeningCash
		dataType: double
		formatString: #,0.00
		lineageTag: 810c6869-69a9-5861-8dbe-c3ab3e4d841c
		summarizeBy: sum
		sourceColumn: OpeningCash

	partition Parameters = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Parameters.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"SnapshotDate", type date}, {"OpeningCash", type number}}, "en-US")
				in
				    Typed

