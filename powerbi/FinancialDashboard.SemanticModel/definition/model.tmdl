model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "DimDate", "DimAccount", "DimPnLLine", "Parameters", "FactLedger", "FactBills", "FactCardSales", "FactBudget", "_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimAccount
ref table DimPnLLine
ref table Parameters
ref table FactLedger
ref table FactBills
ref table FactCardSales
ref table FactBudget
ref table _Measures
ref table 'Time Intelligence'
ref table 'Metric Selector'

ref cultureInfo en-US

